DATABASE_URL=postgresql://user:password@host:5432/database
PAYLOAD_SECRET=replace-with-a-long-random-secret

SUPABASE_STORAGE_BUCKET=order-uploads
SUPABASE_STORAGE_ENDPOINT=https://replace-with-storage-endpoint.example
SUPABASE_STORAGE_REGION=replace-with-region
SUPABASE_STORAGE_ACCESS_KEY_ID=replace-with-access-key-id
SUPABASE_STORAGE_SECRET_ACCESS_KEY=replace-with-secret-access-key

# Unit 2.7 intentionally accepts Stripe Test-mode secret keys only.
STRIPE_SECRET_KEY=sk_test_replace_me
# Stripe CLI or Stripe Test-mode endpoint signing secret. Server-only.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Use one trusted origin with no path, query string, or fragment.
APP_BASE_URL=http://127.0.0.1:3000
